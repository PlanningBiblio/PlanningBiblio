{# forbidden.html.twig #}

<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
  <head>
    <title>Planning</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <script type='text/JavaScript' src='js/jquery-1.11.1.min.js'></script>
    <script type='text/JavaScript' src='js/script.js'></script>
  </head>

  <body>
    <center>
      <h2 id='h2-authentification'>Accès refusé</h2>
      <p class="fw-bold">
        <!-- IP Blocker : Message affiché si l'IP a été bloquée -->
        {% if ip_blocker is defined %}
          L'adresse IP "{{ remote_addr }}" a été bloquée.
          <p id='chrono'></p>
          <script type='text/JavaScript'>decompte({{ ip_blocker }});</script>
        {% endif %}
      </p>
      <footer>
        Planno - 
        <a href="https://www.planno.fr" target="_blank" rel="noopener">www.planno.fr<span class="visually-hidden"> {{ '(new window)' | trans }}</span></a>
      </footer>
    </center>
  </body>
</html>
