{# admin/model/index.html.twig #}

{% extends 'base.html.twig' %}

{% block specificjs %}
  <script type='text/JavaScript'>
    function delete_template(id) {
      if (confirm("Etes vous sûr de vouloir supprimer cet élément ?")) {
        $.ajax({
          url: url('model/' + id),
          type: 'DELETE',
          success: function(data) {
            window.location.reload(false);
          },
          error: function() {
            stackAlert('An error occurred during deletion', 'error');
          }
        });
      }
    }
  </script>
{% endblock %}

{% block page %}
    <h3>Modèles de planning</h3>

    {% if models %}
      <table id='tableModeles' class='CJDataTable' data-sort='[[1]]'>
        <thead>
          <tr>
            <th scope="col" class="dataTableNoSort"></th>
            <th scope="col">Nom</th>
            <th scope="col">Type</th>
            {% if multi_sites %}
                <th scope="col">Site</th>
            {% endif %}
          </tr>
        </thead>
        <tbody>
          {% for model in models %}
            <tr>
              <td>
                <a href='{{ asset("model/") }}{{ model.id }}'><span class='pl-icon pl-icon-edit' title='Modifier'></span></a>
                <a href='javascript:delete_template({{ model.id }});'><span class='pl-icon pl-icon-dropblack' title='Supprimer'></span></a>
              </td>

              <td>
                {{ model.name }}
              </td>
              <td>
                {% if model.week %}
                  Semaine
                {% else %}
                  Jour
                {% endif %}
              </td>
                {% if multi_sites %}
                    <td>{{ sites[model.site] }}</td>
                {% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p>Aucun modèle enregistré</p>
    {% endif %}
{% endblock %}
