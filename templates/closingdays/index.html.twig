{# closingdays/index.html.twig #}

{% extends 'base.html.twig' %}

{% block page %}
  <div id="closingday">
    <div id="joursFeries">
      <div class="admin-div">
      <form name="form1" method="get" action="{{ asset('closingday') }}">
        Sélectionnez l'année à paramétrer
        <select name="annee" onchange="document.form1.submit();">
          <option value="">&nbsp;</option>
          {% for y in years %}
            {% if y == selectedYear %}
              <option value={{y}} selected >{{ y }}</option>
            {% else %}
              <option value={{y}} >{{ y }}</option>
            {% endif%}
          {% endfor %}
        </select>
      </form>

      <!-- Tableau des jours fériés -->
      <form name="form" method="post" action="{{ asset('closingday') }}">
        <input type="hidden" name="_token" id="_token" value="{{ csrf_token('') }}"/>
        <input type="hidden" name="annee" value="{{ selectedYear }}" />
        <table cellspacing="0">
          <tr class="th closingday-header">
            <td>&nbsp;</td>
            <td>Jour</td>
            <td>Férié</td>
            <td>Fermeture</td>
            <td>Nom</td>
            <td>Commentaire</td>
          </tr>
          {% set id = 0 %}
          {% for d in days %}
            {% set id = id + 1 %}
            <tr id="tr{{ id }}">
              <td>
                <a href="javascript:supprime_jourFerie({{ id }});">
                  <span class="pl-icon pl-icon-dropblack" title="Supprimer"></span>
                </a>
              </td>
              <td>
                <input type="text" name="jour[{{ id }}]" value={{ d.day | date('d/m/Y') }} class="c100 datepicker" id="jour{{ id }}"/>
              </td>
              <td>
                <input type="checkbox" name="ferie[{{ id }}]" value="1" {% if d.publicHoliday %} checked {% endif %}/>
              </td>
              <td>
                <input type="checkbox" name="fermeture[{{ id }}]" value="1" {% if d.closed %} checked {% endif %}/>
              </td>
              <td>
                <input type="text" name="nom[{{ id }}]" value="{{ d.name }}" class="c350"/>
              </td>
              <td>
                <input type="text" name="commentaire[{{ id }}]" value="{{ d.comment }}" class="c350"/>
              </td>
            </tr>
          {% endfor %}
          {% for j in nbDays..nbExtra %}
            <tr id="tr{{ j }}">
              <td>
                <a href="javascript:supprime_jourFerie({{ j }});">
                  <span class="pl-icon pl-icon-dropblack" title="Supprimer"></span>
                </a>
              </td>
              <td>
                <input type="text" name="jour['{{ j }}']" class="c100 datepicker" id="jour{{ j }}"/>
              </td>
              <td>
                <input type="checkbox" name="ferie['{{ j }}']" value="1" />
              </td>
              <td>
                <input type="checkbox" name="fermeture['{{ j }}']" value="1" />
              </td>
              <td>
                <input type="text" name="nom['{{ j }}']" class="c350"/>
              </td>
              <td>
                <input type="text" name="commentaire['{{ j }}']" class="c350"/>
              </td>
            </tr>
          {% endfor %}
          <tr>
            <td colspan="6" style="padding:20px 0 0 0; border: 0px solid #000;">
              <input type="submit" role="button" value="Valider" class="btn btn-primary" />
            </td>
          </tr>
        </table>
      </form>
      {% if config('Conges-Enable') %}
        <p><br/>Les jours de fermeture ne seront pas décomptés des congés.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}