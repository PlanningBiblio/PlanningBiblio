{# statistics/time.html.twig #}

{% extends 'base.html.twig' %}

{% block page %}
  <h3>Feuille de temps</h3>
  <p>Les heures affichées sur cette page sont les heures comptées en service public.</p>

  <form name="form" method="get" action="" novalidate>
    <input type='hidden' name='CSRFToken' value='{{ CSRFToken }}' />

    <div class="row row-search">

      <div class="col-xl-auto">
        <input type="text" readonly class="form-control-plaintext form-control-sm mt-2 p-2" id="time-period" value="{% trans with {'%start%': debutFr, '%end%' : finFr} %}From %start% to %end%{% endtrans %}">
      </div>

      <label class="col-xl-auto col-form-label mt-2" for="time-search-start">{% trans %}Start{% endtrans %} :</label>
      <div class="col-xl-auto ps-0">
        <input id="time-search-start" type="text" name="debut" class="datepicker form-control start-date" value="{{ debutFr }}"/>
      </div>

      <label class="col-xl-auto col-form-label mt-2" for="time-search-end">{% trans %}End{% endtrans %} :</label>
      <div class="col-xl-auto ps-0">
        <input id="time-search-end" type="text" name="fin" class="datepicker form-control end-date" value="{{ finFr }}" required/>
      </div>

      {% if groups_exist %}
        <div class="col-3 form-check" style="align-content: center;">
          <input id="selection_groupe" type="checkbox" value="" class="form-check-input mx-2" name="selection_groupe" {{ checked }} />            
          <label class="form-check-label" for="selection_groupe">{% trans %}Display hours by job category{% endtrans %}</label>              
        </div>
      {% endif %}

      <div class="col-xl-2 ps-0">
        <input type="submit" role="button" value="{% trans %}Search{% endtrans %}" class="btn btn-primary m-2"/>
      </div>
    </div>

    <div class="row">
      <div class="invalid-feedback">{% trans from 'validators' %}Please choose a valid date interval.{% endtrans %}</div>
    </div>

  </form>
  <br/>
  {% if tab|length < 1 %}
    Les plannings de la période choisie sont vides.<br/><br/><br/><br/><br/><br/>
  {% else %}
    <table id="tableStatTemps" class="CJDataTable" data-fixedColumns="2" data-responsive="false">
      <thead>
        <tr>
          <th scope="col">Agents</th>
          <th scope="col" style="border-right-color: #000;">Statut</th>
          {% for d in dates %}
            <th scope="col" class="dataTableHeureFR">{{ d[1] | nl2br }}</th>
          {% endfor %}
          {% if nbSites > 1 %}
            {% for i in 1..nbSites %}
              <th scope="col" class="dataTableHeureFR">{{ multisites[i-1] }}</th>
              {% if nbSemaines!= 1 %}
                <th scope="col" class="dataTableHeureFR">Moyenne Hebdo.</th>
              {% endif %}
            {% endfor %}
          {% endif %}
          {% for g in groups %}
            <th scope="col" class="dataTableHeureFR">{{ g.value }}</th>
          {% endfor %}
          <th scope="col" class="dataTableHeureFR">Total</th>
          <th scope="col" class="dataTableHeureFR">Max.</th>
          {% if nbSemaines != 1 %}
            <th scope="col" class="dataTableHeureFR">Moyenne<br/>Hebdo.</th>
            <th scope="col" class="dataTableHeureFR">Max. Hebdo.</th>
          {% endif %}
        </tr>
      </thead>
      <tbody>
        {% for t in tab %}
          <tr style ='vertical-align:top;'>
            <td>{{ t.nom }} {{ t.prenom }}</td>
            {% if t.statut is not null %}
              <td>{{ t.statut }}</td>
            {% else %}
              <td></td>
            {% endif %}
            {% for d in dates %}
              {% if t[d[0]].total != '-' %}
                <td class="text-center">
              {% else %}
                <td class="text-center">
              {% endif %}
                <strong>{{ t[d[0]].total }}</strong>
                {% if groups is iterable %}
                  <br/>
                  {% for g in groups %}
                    {% if t[d[0]].groupe[g.id] is not null %}
                      <br/>
                      {{ g.value }} : {{ t[d[0]].groupe[g.id] }}
                    {% endif %}
                  {% endfor %}
               {% endif %}
              </td>
            {% endfor %}
            {% if nbSites > 1 %}
              {% for i in 1..nbSites %}
                <td class="text-center">{{ t.sites[i-1] }}</td>
                {% if nbSemaines != 1 %}
                  <td class="text-center">{{ t.sitesSemaine[i-1] }}</td>
                {% endif %}
              {% endfor %}
            {% endif %}
            {% for g in groups %}
              <td class="text-center">
                {% if t.groupe[g.id] is defined %}
                  {{ t.groupe[g.id] }}
                {% else %}
                  -
                {% endif %}
              </td>
            {% endfor %}
            {% if nbSemaines != 1 %}
              {% if t.diff1 > 0.5 %}
                <td class="fw-bold text-center" style="background:#CD1B19;">{{ t.total }}</td>
              {% else %}
                {% if t.diff1 <= 0.5 and t.diff2 <= 0.5 %}
                  <td class="fw-bold text-center" style="background:lightgreen;">{{ t.total }}</td>
                {% else %}
                  <td class="text-center">{{ t.total }}</td>
                {% endif %}
              {% endif %}
              <td class="text-center">{{ t.max }}</td>
            {% endif %}
            {% if t.diff1 > 0.5 %}
              <td class="fw-bold text-center" style="background:#CD1B19;">{{ t.semaine }}</td>
            {% else %}
              {% if t.diff1 <= 0.5 and  t.diff2 <= 0.5 %}
                <td class="fw-bold text-center" style="background:lightgreen;">{{ t.semaine }}</td>
              {% else %}
                <td class="text-center">{{ t.semaine }}</td>
              {% endif %}
            {% endif %}
            <td class="text-center">{{ t.heuresHebdo }}</td>
          </tr>
        {% endfor %}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" colspan="2">Nombre d'heures</th>
            {% for d in dates %}
              <td>{{ heures[d[0]] }}</td>
            {% endfor %}
            {% if nbSites > 1 %}
              {% for i in 1..nbSites %}
                <td>{{ sitesHeures[i] }}</td>
                {% if nbSemaines != 1 %}
                  <td></td>
                {% endif %}
              {% endfor %}
            {% endif %}
            {% for g in groups %}
              <td>{{ totauxGroupesHeures[g.id] }}</td>
              {# <td>{{ g.value }}{{ totauxGroupesHeures[g.id] }}</td> #}
            {% endfor %}
            <td>{{ totalHeures }}</td>
            {% if nbSemaines != 1%}
              <td colspan="3"></td>
            {% else %}
              <td></td>
            {% endif %}
          </tr>
          <tr>
            <th scope="row" colspan="2">Nombre d'agents</th>
            {% for d in dates %}
              <td>{{ nbAgents[d[0]] }}</td>
            {% endfor %}
            {% if nbSites >1 %}
              {% for i in 1..nbSites %}
                <td>{{ siteAgents[i] }}</td>
                {% if nbSemaines != 1 %}
                  <td></td>
                {% endif %}
              {% endfor %}
            {% endif %}
            {% for g in groups %}
              <td>{{ totauxGroupesPerso[g.id] }}</td>
            {% endfor %}
            <td>{{ totalAgents }}</td>
            {% if nbSemaines != 1 %}
              <td colspan="3"></td>
            {% else %}
              <td></td>
            {% endif %}
          </tr>
        </tfoot>
    </table>
    <br/>Exporter
    <a href="{{ path('statistics.export', {name: 'temps', type: 'csv'}) }}">CSV</a>&nbsp;&nbsp;
    <a href="{{ path('statistics.export', {name: 'temps', type: 'xls'}) }}">XLS</a>
  {% endif %}
{% endblock %}
