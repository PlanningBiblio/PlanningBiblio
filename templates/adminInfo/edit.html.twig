{# adminInfo/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block page %}
    <div id="content-admin">
        <div class="admin-div">
            <h4>{{ formTitle | trans }}</h4>
    
            <form id="admin-info-form" method="post" action="{{ asset('admin/info') }}" name="form" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('') }}"/>
                <input type="hidden" name="id" value="{{ id }}"/>

                <table class="tableauFiches">
                <tr>
                    <td><label>{{ 'Start date' | trans }}</label> </td>
                    <td>
                    <input type="text" name="start" value="{{ start | dateOrNull('d/m/Y') }}" style="width:100%;" class="datepicker start-date form-control" required/>
                    </td>
                </tr>

                <tr>
                    <td><label>{{ 'End date' | trans }}</label></td>
                    <td>
                    <input type="text" name="end" value="{{ end | dateOrNull('d/m/Y') }}" style="width:100%;" class="datepicker end-date form-control"/>
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td class="invalid-feedback">{% trans from 'validators' %}Please choose a valid date interval.{% endtrans %}</td>
                </tr>

                <tr>
                    <td><label>Texte</label></td>
                    <td>
                    <textarea name="text" rows="3" cols="25" class="emoji-picker-textarea form-control" required>{{ text }}</textarea>
                    </td>
                </tr>

                {% if sitesSelect is not empty %}
                <tr>
                    <td colspan="2">
                    <fieldset id="admin-info-sites" aria-describedby="admin-info-sites-help">
                        <legend class="fs-6">{{ 'Sites' | trans }}</legend>
                        {% for s in sitesSelect %}
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input mt-1 admin-info-site" name="sites[]" id="site-{{ s.id }}" value="{{ s.id }}" {% if s.checked %}checked{% endif %}/>
                            <label class="form-check-label" for="site-{{ s.id }}">{{ s.name }}</label>
                        </div>
                        {% endfor %}
                        <p id="admin-info-sites-help" class="form-text">Si tous les sites sont cochés, le message sera également affiché sur les sites créés ultérieurement.</p>
                        <p id="admin-info-sites-feedback" class="invalid-feedback" role="alert">Veuillez sélectionner au moins un site.</p>
                    </fieldset>
                    </td>
                </tr>
                {% endif %}

                <tr>
                    <td colspan="2" class="text-center">
                    <a href="{{ asset('admin/info') }}" role="button" class="btn btn-secondary" style="margin-left:30px;">{{ 'Cancel' | trans }}</a>
                    {% if id %}
                        <a href="javascript:deleteAdminInfo({{ id }});" role="button" class="btn btn-danger" style="margin-left:30px;" >{{ 'Delete' | trans }}</a>
                    {% endif %}
                    <input type="submit" role="button" value="{{ 'Confirm' | trans }}" class="btn btn-primary" style="margin-left:30px;"/>
                    </td>
                </tr>
                </table>
            </form>
        </div>
    </div>
{% endblock %}
